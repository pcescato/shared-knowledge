---
// Article pages: /<category-dir>/<slug>/ - one static page per knowledge article.
import { getCollection, render } from 'astro:content';
import { promises as fs } from 'node:fs';
import StarlightPage from '@astrojs/starlight/components/StarlightPage.astro';
import AudioPlayer from '../../components/AudioPlayer.astro';
import { categoryDir, withBase } from '../../lib/knowledge.js';

export async function getStaticPaths() {
  const articles = await getCollection('knowledge');
  return articles.map((article) => {
    const [categoryDir, slug] = article.id.split('/');
    return {
      params: { category: categoryDir, slug },
      props: { article },
    };
  });
}

const article = Astro.props.article;
const { category } = article.data;
const categoryPath = categoryDir(category);
const slug = article.id.split('/')[1];

// Audio exists only if the ElevenLabs workflow (or a local run of
// scripts/generate_audio.py) has produced the file for this article.
const audioFile = new URL(`../../../public/audio/${categoryPath}/${slug}.mp3`, import.meta.url);
let hasAudio = false;
try {
  await fs.access(audioFile);
  hasAudio = true;
} catch {
  hasAudio = false;
}

const { Content, headings } = await render(article);
const frontmatter = {
  title: article.data.title,
  description: article.data.description,
};
---

<StarlightPage frontmatter={frontmatter} headings={headings}>
  <nav class="kb-breadcrumb" aria-label="Breadcrumb">
    <a href={withBase('')} style="color:inherit">Knowledge base</a>
    <span aria-hidden="true"> / </span>
    <a href={withBase(`${categoryPath}`)} style="color:inherit">{category}</a>
  </nav>

  <p class="kb-meta">
    {category} · published {article.data.created_at} ·
    {article.data.tags.map((tag) => <a class="kb-tag" href={withBase(`tags/${tag}`)}>#{tag}</a>)}
  </p>

  {
    hasAudio && (
      <AudioPlayer
        src={withBase(`audio/${categoryPath}/${slug}.mp3`)}
        title={article.data.title}
      />
    )
  }

  {/* 
    Markdown content is rendered here with headings starting from ## (h2).
    Starlight injects a page-level h1 from the frontmatter title above.
  */}
  <Content />
</StarlightPage>
