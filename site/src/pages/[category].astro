---
// Category landing pages: /<category-dir>/ (e.g. /devops/, /web-development/)
import { getCollection } from 'astro:content';
import StarlightPage from '@astrojs/starlight/components/StarlightPage.astro';
import { CATEGORIES, categoryDir, withBase } from '../lib/knowledge.js';

export async function getStaticPaths() {
  const articles = await getCollection('knowledge');
  return CATEGORIES.map((category) => ({
    params: { category: categoryDir(category) },
    props: {
      category,
      articles: articles
        .filter((a) => a.data.category === category)
        .sort((a, b) => a.data.title.localeCompare(b.data.title)),
    },
  }));
}

const { category } = Astro.props;
const articles = Astro.props.articles;
const title = `${category} articles`;
const frontmatter = {
  title,
  description: `Knowledge articles in the ${category} category.`,
};
---

<StarlightPage frontmatter={frontmatter}>
  {
    articles.length === 0 && (
      <p>
        No articles in this category yet. Categories are part of a controlled
        vocabulary — new articles arrive here as their Pull Requests are merged.
      </p>
    )
  }
  <ul class="kb-list">
    {articles.map((article) => (
      <li>
        <a href={withBase(`${categoryDir(article.data.category)}/${article.id.split('/')[1]}`)}>
          {article.data.title}
        </a>
        <span class="kb-meta">
          {article.data.created_at} · {article.data.description}
        </span>
      </li>
    ))}
  </ul>
</StarlightPage>
